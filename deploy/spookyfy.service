# Servizio systemd di Spookyfy.
# Installazione:
#   sudo cp deploy/spookyfy.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now spookyfy
# Presuppone il codice in /opt/spookyfy (già compilato con `pnpm build`), l'utente
# di sistema "spookyfy" e la configurazione in /etc/spookyfy/spookyfy.env.

[Unit]
Description=Spookyfy - player musicale self-hosted
Documentation=https://github.com/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spookyfy
Group=spookyfy
WorkingDirectory=/opt/spookyfy/apps/server
EnvironmentFile=/etc/spookyfy/spookyfy.env
ExecStart=/usr/bin/node /opt/spookyfy/apps/server/dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# Indurimento: il servizio scrive solo nelle cartelle dei dati.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/spookyfy
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
