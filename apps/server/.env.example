# Configurazione di Spookyfy. In sviluppo: copia in apps/server/.env.
# In produzione: /etc/spookyfy/spookyfy.env (letto dal servizio systemd).

NODE_ENV=production
# Origine pubblica dell'app (quella del tunnel). Obbligatoria in produzione.
PUBLIC_ORIGIN=https://spookyfy.example.com

# Il server ascolta solo su localhost: lo espone Cloudflare Tunnel.
HOST=127.0.0.1
PORT=8787

# Database SQLite e file musicali (MP3 e copertine).
DATA_DIR=/var/lib/spookyfy/data
MEDIA_DIR=/var/lib/spookyfy/media

# Token di invito per creare account dall'app.
# CAMBIALO: il valore predefinito (spotifymerdacostosa2026) è pubblico nel repository.
# Lascialo vuoto (REGISTRATION_TOKEN=) per disabilitare la registrazione dall'app.
REGISTRATION_TOKEN=cambiami-con-un-token-lungo-e-segreto

# Eseguibili esterni.
YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg

# Importazioni contemporanee: se assente, metà dei core (min 1, max 8).
# INGEST_CONCURRENCY=2
# Priorità dei processi di conversione: 10 su Raspberry Pi, 0 su server potenti.
INGEST_NICE=10

# IP reale del client dall'header CF-Connecting-IP (true dietro Cloudflare Tunnel).
TRUST_CF_HEADERS=true

LOG_LEVEL=info

# Ricerca online di copertine (MusicBrainz, Cover Art Archive, iTunes): off = nessuna richiesta esterna.
COVER_LOOKUP=on

# Optional Spotify module (base app does not require these).
SPOTIFY_ENABLED=false
SPOTIFY_HYBRID_PLAYBACK_ENABLED=false
SPOTIFY_POLICY_RESOLVED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=
SPOTIFY_KEY_ID=
# JSON map key ID -> dedicated base64 32-byte AES key; retain old keys during rotation.
SPOTIFY_ENCRYPTION_KEYS={}
# Explicit development/test fixtures only, rejected in production.
SPOTIFY_FAKE=false
