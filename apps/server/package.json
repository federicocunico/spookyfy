{
  "name": "@spookyfy/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts",
    "cli:prod": "node --env-file-if-exists=.env dist/cli.js",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "@node-rs/argon2": "^2.0.2",
    "@spookyfy/shared": "workspace:*",
    "@spookyfy/spotify": "workspace:*",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.4.0",
    "node-id3": "^0.2.9",
    "sharp": "^0.34.3",
    "ulid": "^3.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "typescript": "^5.7.3",
    "vitest": "^3.2.0",
    "ws": "^8.18.3"
  }
}
