{
  "name": "@spookyfy/gateway",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --dir ../.. build:shared && pnpm --dir ../.. --filter @spookyfy/web build && tsx dev-server.ts",
    "start:dev": "tsx dev-server.ts",
    "vercel-build": "pnpm --dir ../.. build:shared && pnpm --dir ../.. --filter @spookyfy/web build && node scripts/copy-web.mjs && node scripts/count-functions.mjs",
    "count-functions": "node scripts/count-functions.mjs",
    "cli": "tsx --env-file-if-exists=.env lib/cli-main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@spookyfy/shared": "workspace:*",
    "@upstash/redis": "^1.40.0",
    "jose": "^6.2.13",
    "redis": "^5.8.0",
    "youtubei.js": "^18.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.3",
    "typescript": "^5.7.3",
    "vitest": "^3.2.0"
  }
}
