# Variabili del gateway (modalità client su Vercel). Su Vercel: Project Settings → Environment Variables.
# In locale (CLI e dev server): copia in apps/gateway/.env.

# Segreto per firmare le sessioni: almeno 32 caratteri casuali (es. `openssl rand -base64 48`).
SESSION_SECRET=
# Token di invito per la registrazione dall'app. CAMBIALO; vuoto = registrazione disabilitata.
REGISTRATION_TOKEN=cambiami-con-un-token-lungo-e-segreto
# Origine pubblica dell'app. Su Vercel, se assente, si usa il dominio di produzione del progetto.
# PUBLIC_ORIGIN=https://spookyfy.example.com

# KV: impostata dall'integrazione Redis (Redis Cloud) del Marketplace Vercel.
# In locale, per la CLI degli account: vercel env pull apps/gateway/.env --environment=production
REDIS_URL=
# In alternativa, Upstash Redis (via REST):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional Spotify module (base app does not require these).
SPOTIFY_ENABLED=false
SPOTIFY_HYBRID_PLAYBACK_ENABLED=false
SPOTIFY_POLICY_RESOLVED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=
SPOTIFY_KEY_ID=
# JSON map key ID -> dedicated base64 32-byte AES key; retain old keys during rotation.
SPOTIFY_ENCRYPTION_KEYS={}
# Explicit development/test fixtures only, rejected in production.
SPOTIFY_FAKE=false
