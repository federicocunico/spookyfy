{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run vercel-build",
  "outputDirectory": "public",
  "regions": ["fra1"],
  "functions": {
    "api/health.ts": { "maxDuration": 10 },
    "api/auth/[action].ts": { "maxDuration": 15 },
    "api/search.ts": { "maxDuration": 20 },
    "api/meta/[id].ts": { "maxDuration": 20 },
    "api/audio/[id].ts": { "maxDuration": 300 },
    "api/cover/[id].ts": { "maxDuration": 15 },
    "api/lookup/[action].ts": { "maxDuration": 20 }
  },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(sw.js|index.html|manifest.webmanifest|registerSW.js)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
